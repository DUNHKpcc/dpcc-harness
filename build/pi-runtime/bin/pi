#!/bin/sh
set -eu

if [ -z "${PCC_AGENT_PI_RUNTIME_HOST:-}" ] || [ -z "${PCC_AGENT_PI_ENTRY:-}" ]; then
  printf '%s\n' 'PccAgent bundled Pi runtime is not configured.' >&2
  exit 78
fi

export ELECTRON_RUN_AS_NODE=1

if [ -z "${PCC_AGENT_PI_CONTEXT_EXTENSION:-}" ]; then
  printf '%s\n' 'PccAgent bundled Pi context bridge is not configured.' >&2
  exit 78
fi

set -- "$@" --extension "$PCC_AGENT_PI_CONTEXT_EXTENSION"

if [ -n "${PCC_AGENT_PI_GLOBAL_SKILLS:-}" ]; then
  set -- "$@" --skill "$PCC_AGENT_PI_GLOBAL_SKILLS"
fi

if [ -n "${PCC_AGENT_PI_PROJECT_SKILLS:-}" ]; then
  set -- "$@" --skill "$PCC_AGENT_PI_PROJECT_SKILLS"
fi

if [ -n "${PCC_AGENT_PI_MCP_EXTENSION:-}" ] || [ -n "${PCC_AGENT_PI_MCP_CONFIG:-}" ] || [ -n "${PCC_AGENT_PI_MCP_ADAPTER:-}" ]; then
  if [ -z "${PCC_AGENT_PI_MCP_EXTENSION:-}" ] || [ -z "${PCC_AGENT_PI_MCP_CONFIG:-}" ] || [ -z "${PCC_AGENT_PI_MCP_ADAPTER:-}" ]; then
    printf '%s\n' 'PccAgent bundled Pi MCP runtime is incomplete.' >&2
    exit 78
  fi
  set -- "$@" --extension "$PCC_AGENT_PI_MCP_EXTENSION"
fi

exec "$PCC_AGENT_PI_RUNTIME_HOST" "$PCC_AGENT_PI_ENTRY" "$@"
