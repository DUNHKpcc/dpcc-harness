{
  "name": "pcc-agent",
  "version": "2.2.4",
  "productName": "PccAgent",
  "description": "Desktop client for Pi and custom ACP coding agents",
  "author": {
    "name": "DUNHKpcc",
    "email": "sjh2329952249@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/DUNHKpcc/dpcc-harness",
  "repository": {
    "type": "git",
    "url": "https://github.com/DUNHKpcc/dpcc-harness.git"
  },
  "main": "electron/dist/main.js",
  "scripts": {
    "build:electron": "tsup --config tsup.electron.config.ts",
    "typecheck": "tsc --noEmit && pnpm typecheck:electron",
    "typecheck:electron": "tsc --noEmit -p electron/tsconfig.json",
    "dev": "concurrently \"vite\" \"pnpm build:electron --watch\" \"node scripts/delay.js http://localhost:5173/ electron/dist/main.js && cross-env ELECTRON_ENABLE_LOGGING=1 electron .\"",
    "build": "pnpm build:electron && vite build",
    "start": "electron .",
    "pi:runtime:check": "node scripts/check-pi-runtime.mjs",
    "workflow:doctor": "bash scripts/agent-workflow/doctor.sh",
    "workflow:start": "bash scripts/agent-workflow/start.sh",
    "workflow:hook": "bash scripts/agent-workflow/hook.sh",
    "workflow:handoff": "bash scripts/agent-workflow/handoff.sh",
    "workflow:record": "bash scripts/agent-workflow/record.sh",
    "workflow:review": "bash scripts/agent-workflow/review.sh",
    "workflow:status": "bash scripts/agent-workflow/status.sh",
    "workflow:subagent": "bash scripts/agent-workflow/subagent.sh",
    "workflow:stop": "bash scripts/agent-workflow/stop.sh",
    "workflow:pi-reference": "node scripts/agent-workflow/pi-reference.mjs",
    "workflow:sync-pi-reference": "node scripts/agent-workflow/pi-reference.mjs sync",
    "workflow:check-pi-reference": "node scripts/agent-workflow/pi-reference.mjs check",
    "workflow:verify-pi-upstream": "node scripts/agent-workflow/pi-reference.mjs verify-upstream",
    "workflow:benchmark-pi": "node scripts/agent-workflow/pi-reference.mjs benchmark",
    "bundle:portable-git": "node scripts/bundle-portable-git.js",
    "dist": "pnpm build && electron-builder --config electron-builder.config.js",
    "dist:fast": "pnpm build && electron-builder --config electron-builder.config.js --dir",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --config electron-builder.config.js",
    "dist:win": "pnpm build && node scripts/bundle-portable-git.js --platform win32 --arch x64 && electron-builder --win --x64 --config electron-builder.config.js",
    "dist:win:store": "pnpm build && node scripts/bundle-portable-git.js --platform win32 --arch x64 && electron-builder --win appx --x64 --config electron-builder.config.js --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --config electron-builder.config.js",
    "postinstall": "node -e \"require('child_process').execSync('electron-rebuild'+(process.platform==='darwin'?'':' --ignore electron-liquid-glass'),{stdio:'inherit'})\"",
    "test": "vitest run --config vitest.config.electron.ts && pnpm test:agent-workflow",
    "test:watch": "vitest --config vitest.config.electron.ts",
    "test:agent-workflow": "node --test scripts/agent-workflow/workflow.test.mjs",
    "test:pi-integration": "node scripts/test-pi-acp-integration.mjs && pnpm exec vitest run --config vitest.config.electron.ts src/lib/engine/__tests__/pi-acp-child.integration.test.ts && node scripts/test-pi-native-integration.mjs",
    "test:electron-recovery": "node scripts/test-electron-acp-recovery.mjs --test-mode=acp-recovery",
    "test:ui": "pnpm build:electron && playwright test",
    "test:ui:debug": "pnpm build:electron && playwright test --debug",
    "package:smoke": "node scripts/check-packaged-app.mjs",
    "docs:check": "node scripts/check-release-docs.mjs",
    "test-map:check": "node scripts/check-test-map.mjs"
  },
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.15.0",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@fontsource-variable/noto-serif-sc": "^5.2.10",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/instrument-serif": "^5.2.8",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.22",
    "dompurify": "^3.3.3",
    "electron-context-menu": "^4.1.1",
    "electron-liquid-glass": "github:darkkatarsis/electron-liquid-glass",
    "electron-updater": "^6.8.3",
    "i18next": "^26.3.1",
    "konva": "^10.2.0",
    "mermaid": "^11.13.0",
    "motion": "^12.34.3",
    "node-html-parser": "^9.0.1",
    "node-pty": "^1.1.0",
    "pi-acp": "0.0.33",
    "pi-mcp-adapter": "2.31.0",
    "qrcode": "^1.5.4",
    "react-i18next": "^17.0.8",
    "react-konva": "^19.2.3",
    "refractor": "^5.0.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/notarize": "^3.1.0",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/dompurify": "^3.2.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.2.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "diff": "^8.0.3",
    "electron": "^40.4.0",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.8.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-agent-core": "0.84.1",
      "@earendil-works/pi-ai": "0.84.1",
      "@earendil-works/pi-client": "0.84.1",
      "@earendil-works/pi-protocol": "0.84.1",
      "@earendil-works/pi-telemetry": "0.84.1",
      "@earendil-works/pi-tui": "0.84.1"
    }
  }
}
